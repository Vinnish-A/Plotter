# OS and editor metadata
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
.idea/
.vscode/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python caches and environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/
env/

# R session, package, and ad-hoc plotting artifacts
.Rhistory
.RData
.Ruserdata
.Rproj.user/
renv/library/
packrat/lib*/
*.Rout
Rplots.pdf

# Node/UI dependencies and reports
node_modules/
dist/
build/
coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
playwright-report/
test-results/

# Local tool state
.cache/
.playwright-mcp/
tmp/
temp/
*.tmp
*.bak

# Large external source mirrors and packaged runtimes
/raw/
/external/

# Root-level generated reports/exports; Vault case outputs are handled below.
/outputs/

# Intake source drops are evidence, not the standardized interface.
/graft/intake/**/source/

# Runtime logs outside case contracts.
/retinue/logs/
/ui/*.log
/ui/*.pid

# Agent-test quick-look gallery regenerated by the runner.
/bastard/generated/output_pngs/

# Vault quarantine and local preview/export caches.
/vault/folded_assets/
/vault/previews/
/vault/successes/
/vault/failures/

# Per-case heavy evidence folders. Keep standardized CSV/script/metadata files tracked.
/vault/material/**/raw/
/vault/material/**/data_raw/
/vault/material/**/docs/

# Per-case generated outputs: track only reproducibility targets.
/vault/material/**/outputs/*
!/vault/material/**/outputs/
!/vault/material/**/outputs/rebuilt.png
!/vault/material/**/outputs/rebuilt.pdf
